{
  "version": "1.0.0",
  "project": {
    "name": "Capstone — AI-Driven SDLC",
    "description": "AI-powered SDLC pipeline for a brownfield React + Node.js app with 7 specialized agents",
    "root": "./",
    "agentDirectory": "./.claude/agents"
  },
  "profiles": {
    "default": "work",
    "available": ["work", "personal"]
  },
  "agents": {
    "auto-discover": true,
    "directory": ".claude/agents",
    "manifest": ".codemie/agents-manifest.json"
  },
  "cli": {
    "enableSlashCommands": true,
    "enableAgentMenu": true,
    "defaultModel": "claude-opus-4-7"
  },
  "integrations": {
    "jira": {
      "enabled": true,
      "baseUrl": "${JIRA_BASE_URL}",
      "tokenEnv": "JIRA_API_TOKEN"
    },
    "confluence": {
      "enabled": true,
      "baseUrl": "${CONFLUENCE_BASE_URL}",
      "tokenEnv": "CONFLUENCE_API_TOKEN"
    },
    "github": {
      "enabled": true,
      "tokenEnv": "GITHUB_TOKEN"
    }
  }
}
