{
  "profile": "work",
  "description": "Work profile for EPAM capstone project (full SDLC access)",
  "provider": "claude",
  "model": "claude-opus-4-7",
  "context": {
    "project": "Capstone — AI-Driven SDLC",
    "jiraProject": "EPMCDMETST",
    "team": "mm-learning-group-1",
    "environment": "work"
  },
  "integrations": {
    "jira": {
      "enabled": true,
      "baseUrl": "${JIRA_BASE_URL}",
      "project": "EPMCDMETST",
      "tokenEnv": "JIRA_API_TOKEN"
    },
    "confluence": {
      "enabled": true,
      "baseUrl": "${CONFLUENCE_BASE_URL}",
      "spaceKey": "CAPSTONE",
      "tokenEnv": "CONFLUENCE_API_TOKEN"
    },
    "github": {
      "enabled": true,
      "repo": "KaladiSanthoshKumarReddy/capstone",
      "branch": "main",
      "tokenEnv": "GITHUB_TOKEN"
    }
  },
  "agents": {
    "enabled": [
      "ba-agent",
      "architect-agent",
      "dev-agent",
      "qa-agent",
      "review-agent",
      "docs-agent"
    ],
    "default": "dev-agent",
    "slashCommands": {
      "/ba": "ba-agent",
      "/architect": "architect-agent",
      "/dev": "dev-agent",
      "/qa": "qa-agent",
      "/review": "review-agent",
      "/docs": "docs-agent"
    }
  },
  "modelDefaults": {
    "temperature": 0.7,
    "maxTokens": 4096,
    "topP": 0.9
  },
  "environment": {
    "loadFrom": ".env",
    "requiredVars": [
      "JIRA_API_TOKEN",
      "CONFLUENCE_API_TOKEN",
      "GITHUB_TOKEN",
      "JIRA_BASE_URL",
      "CONFLUENCE_BASE_URL"
    ]
  },
  "workingDirectory": "./",
  "cacheEnabled": true,
  "verboseLogging": false
}
