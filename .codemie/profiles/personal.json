{
  "profile": "personal",
  "description": "Personal profile (lightweight, dev/qa/docs agents only)",
  "provider": "claude",
  "model": "claude-sonnet-4-6",
  "context": {
    "project": "Capstone — AI-Driven SDLC",
    "environment": "personal"
  },
  "integrations": {
    "jira": {
      "enabled": false
    },
    "confluence": {
      "enabled": false
    },
    "github": {
      "enabled": true,
      "repo": "KaladiSanthoshKumarReddy/capstone",
      "branch": "main",
      "tokenEnv": "GITHUB_TOKEN"
    }
  },
  "agents": {
    "enabled": [
      "dev-agent",
      "qa-agent",
      "docs-agent"
    ],
    "default": "dev-agent",
    "slashCommands": {
      "/dev": "dev-agent",
      "/qa": "qa-agent",
      "/docs": "docs-agent"
    }
  },
  "modelDefaults": {
    "temperature": 0.6,
    "maxTokens": 2048,
    "topP": 0.9
  },
  "environment": {
    "loadFrom": ".env",
    "requiredVars": [
      "GITHUB_TOKEN"
    ]
  },
  "workingDirectory": "./",
  "cacheEnabled": true,
  "verboseLogging": false
}
